# ── Claude API (Phase 3) ─────────────────────────────
ANTHROPIC_API_KEY=

# ── Weather (Phase 2) ────────────────────────────────
OPENWEATHERMAP_API_KEY=

# ── MongoDB Atlas ────────────────────────────────────
# Get this from Atlas: Database → Connect → Drivers
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=pitwall

# ── Redis ────────────────────────────────────────────
# "redis" is the docker-compose service name (containers reach
# each other by service name on the compose network)
REDIS_URL=redis://redis:6379/0

# ── App ──────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000

# ── Frontend (read by the browser, hence localhost) ──
NEXT_PUBLIC_API_URL=http://localhost:8000
